{"nodes": [{"id": "deploy_readme_deployment_guide", "label": "im-tools.org Deployment Guide", "file_type": "document", "source_file": "deploy/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "deploy_readme_oracle_always_free_vm", "label": "Oracle Cloud Always Free VM (Ampere A1)", "file_type": "concept", "source_file": "deploy/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "deploy_readme_cloudflare_tunnel", "label": "Cloudflare Tunnel (outbound-only)", "file_type": "rationale", "source_file": "deploy/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "OCI has two independent firewalls (security list and iptables); an outbound-only tunnel needs neither and never exposes the VM's IP."}, {"id": "deploy_readme_stateful_hosting_constraint", "label": "Stateful Node + SQLite WAL Hosting Constraint", "file_type": "rationale", "source_file": "deploy/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "better-sqlite3 writes a real file in WAL mode and sessions live in it, so it needs a persistent disk and long-running process, ruling out Workers/Pages without a D1 rewrite."}, {"id": "deploy_readme_seed_password_guard", "label": "Production Seed Password Guard", "file_type": "concept", "source_file": "deploy/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "deploy_readme_aiagent_forced_command", "label": "aiagent Account & Forced Command (am-agent wrapper)", "file_type": "concept", "source_file": "deploy/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The wrapper matches SSH_ORIGINAL_COMMAND but never executes it; it is a root-