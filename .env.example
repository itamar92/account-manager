# Green Invoice (Morning) — used by scripts/build_havila.py and the web app's Morning sync.
# Point GREEN_INVOICE_BASE_URL at the sandbox to exercise the write path without
# issuing real documents: https://sandbox.d.greeninvoice.co.il/api/v1
GREEN_INVOICE_ID=
GREEN_INVOICE_SECRET=
GREEN_INVOICE_BASE_URL=

# Google Calendar — read-only show sync for the web app (app/server/calendarSync.ts).
# Create an OAuth client (type: Desktop) in Google Cloud, grant the
# https://www.googleapis.com/auth/calendar.readonly scope, and store the refresh token.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# Calendar holding the shows. Defaults to the account's primary calendar.
GOOGLE_CALENDAR_ID=

# Meta Ads (Facebook/Instagram) — read-only campaign spend for the band's shows
# (app/server/metaClient.ts). Use a **System User** token, not a personal login token: it
# belongs to the business rather than to a person, so it does not expire every 60 days.
#   1. developers.facebook.com → create an app (type: Business), attach it to your Business
#   2. Business Settings → System Users → add one → Assign assets: the app, and the ad account
#   3. Generate token → select the app → scope `ads_read` → expiration: never
# Reading your own ad account with ads_read needs no App Review.
META_ACCESS_TOKEN=
# The ad account running the campaigns. Either spelling works: 123456789 or act_123456789.
META_AD_ACCOUNT_ID=
# Graph API version, and a base URL override for pointing the sync at a stub in testing.
META_API_VERSION=
META_GRAPH_URL=

# Encrypts the secrets saved from the UI (the agent's SSH key). Optional: with it unset the app
# generates data/secret.key on first use instead — back that file up alongside the database.
APP_SECRET_KEY=

# AI agent (Moonlight → יועץ קמפיינים) — reached over SSH, not over an API.
# The agent is a command-line tool on another machine where it is already logged in. The app opens
# an SSH session, writes the prompt to that command's stdin and reads the answer back, so the only
# credential here is a key to one fixed command — there is no AI API key in this file by design.
#
# These are the FALLBACK. The normal place for all of it is Settings → סוכן AI in the app, which
# has a field for each of them; what is saved there wins, and a field left empty there falls back
# to the variable here. Setting up from a script is what these are still for.
#   1. On the agent host: create a dedicated user and install the CLI, logged in as yourself
#   2. On your own machine: ssh-keygen -t ed25519 -f ~/.ssh/am-agent -N ''
#   3. Append the public half to that user's ~/.ssh/authorized_keys, restricted to the one command:
#      command="claude -p --output-format json",no-port-forwarding,no-agent-forwarding,no-pty ssh-ed25519 AAAA…
#   4. ssh-keyscan -t ed25519 <agent-host>   → paste the output into AGENT_SSH_HOST_KEY
AGENT_SSH_HOST=
AGENT_SSH_PORT=
AGENT_SSH_USER=
# The private key. Newlines written as \n, since a PEM cannot go on one line any other way.
# AGENT_SSH_KEY_PATH is the alternative when the key is mounted as a file.
AGENT_SSH_KEY=
AGENT_SSH_KEY_PATH=
# The key's passphrase, if it has one.
AGENT_SSH_PASSPHRASE=
# The agent host's own public key. Without it the app refuses to connect in production: an
# unpinned host means whoever answers the address gets the key.
AGENT_SSH_HOST_KEY=
# The command run on that machine. Never assembled from a request — this is the whole of it.
AGENT_COMMAND=
AGENT_TIMEOUT_MS=

# IEC (electricity)
IEC_ID=
IEC_PASSWORD=

# Partner (internet)
PARTNER_PHONE=
PARTNER_PASSWORD=

# HOT Mobile
HOTMOBILE_PHONE=
HOTMOBILE_PASSWORD=

# Mei Hod Hasharon (water)
WATER_ACCOUNT=
WATER_ID=

# Hod Hasharon Arnona
ARNONA_ID=
ARNONA_PROPERTY=
