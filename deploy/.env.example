# Copy to deploy/.env on the VM and fill in. This file holds live credentials —
# deploy/.env is git-ignored and must stay that way.
#
#   cp .env.example .env && chmod 600 .env

# --- Cloudflare Tunnel ---------------------------------------------------
# From Cloudflare Zero Trust → Networks → Tunnels → your tunnel → Install
# connector. Copy only the token itself out of the shown command.
TUNNEL_TOKEN=

# --- First-run passwords -------------------------------------------------
# Read once, when the database is created. Changing them later does nothing;
# change the password in the app instead. The app refuses to start in
# production if these are unset on first run.
SEED_OWNER_EMAIL=
SEED_OWNER_NAME=
SEED_OWNER_PASSWORD=

# --- Morning / Green Invoice (optional) ----------------------------------
# Without these the Morning sync reports itself as unconfigured in the UI.
GREEN_INVOICE_ID=
GREEN_INVOICE_SECRET=
# Point at https://sandbox.d.greeninvoice.co.il/api/v1 to exercise the write
# path without issuing real documents.
GREEN_INVOICE_BASE_URL=

# --- Google Calendar (optional) ------------------------------------------
# Read-only calendar sync. Without these the calendar rules page still works
# but reports Google as unconfigured.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=

# --- Secrets saved from the UI (optional) --------------------------------
# Encrypts the agent's SSH key in the database. Leave unset and the app
# generates secret.key in the data volume instead, which the backup in
# README.md §5 already covers.
APP_SECRET_KEY=

# --- AI agent for יועץ קמפיינים (optional) --------------------------------
# Reached over SSH, not over an API: the agent is a CLI on a machine where it
# is already logged in, and the app pipes it a prompt. No AI API key lives on
# this box by design — the credential below opens one fixed command and
# nothing else.
#
# These are the FALLBACK: the normal place to enter all of it is Settings →
# סוכן AI in the app, which needs no restart and keeps the private key out of
# this file. What is saved there wins; a field left empty there falls back to
# the variable here.
#
# Pointing this at the VM itself (the usual case) needs the container to reach
# its own host, which docker-compose.yml already arranges via host.docker.internal.
# Set up the account and the key restriction first — see README.md, "The AI agent".
AGENT_SSH_HOST=host.docker.internal
AGENT_SSH_PORT=22
AGENT_SSH_USER=
# The private key, newlines written as \n. Keep this file chmod 600.
AGENT_SSH_KEY=
# ssh-keyscan output for the agent host. Required: without it the app refuses
# to connect in production rather than handing the key to whoever answers.
AGENT_SSH_HOST_KEY=
AGENT_COMMAND=claude -p --output-format json
AGENT_TIMEOUT_MS=120000

# Optional. Where the quote links sent to clients point, when clients reach the app at a
# different address from the band (e.g. a hostname left outside Cloudflare Access).
# Empty = the address the app was opened at.
# Also the base of the «סימון כבוצע» link in campaign-task reminder emails, which are sent
# with no request to take an address from — so without it those emails carry no links.
PUBLIC_BASE_URL=

# --- Campaign-task reminder emails (optional) -------------------------------
# The app emails the band member who owns a show's campaign on each task's due
# date (09:00 Israel time), and every 2 days after while it stays open. Without
# these nothing is sent and the tasks tab says so.
#
# Gmail: turn on 2-Step Verification, then Google Account → Security → App
# passwords → create one. Paste it as SMTP_PASS (spaces are fine).
SMTP_USER=
SMTP_PASS=
# Optional — defaults to "<band name> <SMTP_USER>". Gmail only sends as the
# account itself or an alias verified in Gmail's settings.
SMTP_FROM=
# Optional — defaults to smtp.gmail.com:465.
SMTP_HOST=
SMTP_PORT=
