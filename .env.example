# Green Invoice (Morning) — used by scripts/build_havila.py and the web app's Morning sync.
# Point GREEN_INVOICE_BASE_URL at the sandbox to exercise the write path without
# issuing real documents: https://sandbox.d.greeninvoice.co.il/api/v1
GREEN_INVOICE_ID=
GREEN_INVOICE_SECRET=
GREEN_INVOICE_BASE_URL=

# Google Calendar — read-only show sync for the web app (app/server/calendarSync.ts).
# Create an OAuth client (type: Desktop) in Google Cloud, grant the
# https://www.googleapis.com/auth/calendar.readonly scope, and store the refresh token.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# Calendar holding the shows. Defaults to the account's primary calendar.
GOOGLE_CALENDAR_ID=

# IEC (electricity)
IEC_ID=
IEC_PASSWORD=

# Partner (internet)
PARTNER_PHONE=
PARTNER_PASSWORD=

# HOT Mobile
HOTMOBILE_PHONE=
HOTMOBILE_PASSWORD=

# Mei Hod Hasharon (water)
WATER_ACCOUNT=
WATER_ID=

# Hod Hasharon Arnona
ARNONA_ID=
ARNONA_PROPERTY=
