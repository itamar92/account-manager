# Green Invoice (Morning) — used by scripts/build_havila.py and the web app's Morning sync.
# Point GREEN_INVOICE_BASE_URL at the sandbox to exercise the write path without
# issuing real documents: https://sandbox.d.greeninvoice.co.il/api/v1
GREEN_INVOICE_ID=
GREEN_INVOICE_SECRET=
GREEN_INVOICE_BASE_URL=

# Google Calendar — read-only show sync for the web app (app/server/calendarSync.ts).
# Create an OAuth client (type: Desktop) in Google Cloud, grant the
# https://www.googleapis.com/auth/calendar.readonly scope, and store the refresh token.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# Calendar holding the shows. Defaults to the account's primary calendar.
GOOGLE_CALENDAR_ID=

# Meta Ads (Facebook/Instagram) — read-only campaign spend for the band's shows
# (app/server/metaClient.ts). Use a **System User** token, not a personal login token: it
# belongs to the business rather than to a person, so it does not expire every 60 days.
#   1. developers.facebook.com → create an app (type: Business), attach it to your Business
#   2. Business Settings → System Users → add one → Assign assets: the app, and the ad account
#   3. Generate token → select the app → scope `ads_read` → expiration: never
# Reading your own ad account with ads_read needs no App Review.
META_ACCESS_TOKEN=
# The ad account running the campaigns. Either spelling works: 123456789 or act_123456789.
META_AD_ACCOUNT_ID=
# Graph API version, and a base URL override for pointing the sync at a stub in testing.
META_API_VERSION=
META_GRAPH_URL=

# IEC (electricity)
IEC_ID=
IEC_PASSWORD=

# Partner (internet)
PARTNER_PHONE=
PARTNER_PASSWORD=

# HOT Mobile
HOTMOBILE_PHONE=
HOTMOBILE_PASSWORD=

# Mei Hod Hasharon (water)
WATER_ACCOUNT=
WATER_ID=

# Hod Hasharon Arnona
ARNONA_ID=
ARNONA_PROPERTY=
