# Copy to deploy/.env on the VM and fill in. This file holds live credentials —
# deploy/.env is git-ignored and must stay that way.
#
#   cp .env.example .env && chmod 600 .env

# --- Cloudflare Tunnel ---------------------------------------------------
# From Cloudflare Zero Trust → Networks → Tunnels → your tunnel → Install
# connector. Copy only the token itself out of the shown command.
TUNNEL_TOKEN=

# --- First-run passwords -------------------------------------------------
# Read once, when the database is created. Changing them later does nothing;
# change the password in the app instead. The app refuses to start in
# production if these are unset on first run.
SEED_OWNER_PASSWORD=
SEED_BAND_PASSWORD=

# --- Morning / Green Invoice (optional) ----------------------------------
# Without these the Morning sync reports itself as unconfigured in the UI.
GREEN_INVOICE_ID=
GREEN_INVOICE_SECRET=
# Point at https://sandbox.d.greeninvoice.co.il/api/v1 to exercise the write
# path without issuing real documents.
GREEN_INVOICE_BASE_URL=

# --- Google Calendar (optional) ------------------------------------------
# Read-only calendar sync. Without these the calendar rules page still works
# but reports Google as unconfigured.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=

# --- AI agent for יועץ קמפיינים (optional) --------------------------------
# Reached over SSH, not over an API: the agent is a CLI on a machine where it
# is already logged in, and the app pipes it a prompt. No AI API key lives on
# this box by design — the credential below opens one fixed command and
# nothing else.
#
# Pointing this at the VM itself (the usual case) needs the container to reach
# its own host, which docker-compose.yml already arranges via host.docker.internal.
# Set up the account and the key restriction first — see README.md, "The AI agent".
AGENT_SSH_HOST=host.docker.internal
AGENT_SSH_PORT=22
AGENT_SSH_USER=
# The private key, newlines written as \n. Keep this file chmod 600.
AGENT_SSH_KEY=
# ssh-keyscan output for the agent host. Required: without it the app refuses
# to connect in production rather than handing the key to whoever answers.
AGENT_SSH_HOST_KEY=
AGENT_COMMAND=claude -p --output-format json
AGENT_TIMEOUT_MS=120000
