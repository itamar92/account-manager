{"nodes": [{"id": "app_readme_account_manager_web_app", "label": "Account Manager Web App", "file_type": "document", "source_file": "app/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Unified accounting dashboard replacing the Google Sheets workbook: personal freelance accounting (clients, works, invoices) plus Moonlight band finance in one app, with an external API for the Morning app."}, {"id": "app_readme_tech_stack", "label": "React 19 + Vite + Express + SQLite Stack", "file_type": "concept", "source_file": "app/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "app_readme_sqlite_database", "label": "SQLite Database (account-manager.db, better-sqlite3)", "file_type": "concept", "source_file": "app/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "app_readme_works_lifecycle", "label": "Works (\u05e2\u05d1\u05d5\u05d3\u05d5\u05ea) unpaid \u2192 invoiced \u2192 paid", "file_type": "concept", "source_file": "app/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "app_readme_client_delete_guards", "label": "Client Deletion Guards", "file_type": "rationale", "source_file": "app/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A client holding invoices is refused (billing history would point at nothing); a client fed by an enabled calendar rule is refused because the next sync would recreate it; uninvoiced works are deleted only on explicit request."}, {"id": "app_readme_role_access_control", "label": "Owner / Band Role Access (server-enforced)", "file_type": "concept", "source_file": "app/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "app_readme_seeded_users", "label": "Seeded Users and SEED_* Passwords", "file_type": "concept", "source_file": "app/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "app_readme_show_page", "label": "Show Page (/moonlight/shows/:id)", "file_type": "concept", "source_file": "app/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One page per show replaced three tables (income / show expenses / staffing) that forced reading across tabs to assemble a gig's numbers."}, {"id": "app_readme_event_expense_clear_vs_delete", "label": "Event Expense Row: Clear vs Delete", "file_type": "rationale", "source_file": "app/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every show owns exactly one expense row, so deleting an attached row empties it (keeps it to type into) while an unattached legacy row is deleted outright."}, {"id": "app_readme_expenses_page", "label": "\u05d4\u05d5\u05e6\u05d0\u05d5\u05ea Expenses Page (read-only Morning mirror)", "file_type": "concept", "source_file": "app/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Expenses are entered and classified in Morning; the app only shows them beside the income they are set against."}, {"id": "app_readme_expense_status_unknown", "label": "\u05e1\u05d8\u05d8\u05d5\u05e1 \u05dc\u05d0 \u05d9\u05d3\u05d5\u05e2 Expense Status", "file_type": "rationale", "source_file": "app/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A real third state instead of a tidier default: mislabelling unrecognised payloads as \u05d8\u05e8\u05dd \u05d3\u05d5\u05d5\u05d7 was both wrong and invisible."}, {"id": "app_readme_spent_vs_deductible", "label": "Spent vs Deductible Expense Figures", "file_type": "rationale", "source_file": "app/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Anything that claims money back counts deductibleAmount/deductibleVat; anything about money that left the business counts the full figures; the gap is real money that cannot be reclaimed."}, {"id": "app_readme_expense_status_probe", "label": "Expense Status Audit & expenses:probe", "file_type": "concept", "source_file": "app/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "app_readme_expenses_raw_payload", "label": "expenses.raw Payload Retention", "file_type": "concept", "source_file": "app/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Keeps the Morning payload each row was mapped from so a field Morning spells differently can be seen rather than guessed at."}, {"id": "app_readme_workspace_shell", "label": "Two-Workspace Shell (data-ws attribute)", "file_type": "rationale", "source_file": "app/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Business and Moonlight are separate books, so they get separate navigation and accent colours hung off one data-ws attribute; colours are named by purpose so no page hard-codes a palette."}, {"id": "app_readme_inbox", "label": "\u05de\u05d4 \u05d3\u05d5\u05e8\u05e9 \u05d8\u05d9\u05e4\u05d5\u05dc Inbox (/api/inbox)", "file_type": "concept", "source_file": "app/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every item is derived from the books on each load, so an item disappears by being dealt with, never by being dismissed."}, {"id": "app_readme_dashboard_overview", "label": "\u05e1\u05e7\u05d9\u05e8\u05d4 Dashboard Overview (overview.ts)", "file_type": "concept", "source_file": "app/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A running period ends today, so year-to-date is compared against the same window last year rather than a full twelve months."}, {"id": "app_readme_expense_recognition_rates", "label": "Expense Recognition Rates (expense_recognition_rates)", "file_type": "concept", "source_file": "app/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Per-category deductible shares (45% car, 15% household bills, 80% communications) taken from expense-inventory-2026.md; defaults overridable in settings."}, {"id": "app_readme_reports", "label": "\u05d3\u05d5\u05d7\u05d5\u05ea Reports Page", "file_type": "concept", "source_file": "app/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "app_readme_accrual_basis", "label": "Accrual Basis (\u05de\u05e6\u05d8\u05d1\u05e8)", "file_type": "rationale", "source_file": "app/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "An Israeli VAT filing reports a document in the period it was issued, whether or not the money arrived."}, {"id": "app_readme_monthly_pnl", "label": "monthlyPnl Shared P&L Query (ExpenseBasis)", "file_type": "concept", "source_file": "app/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One query with one ExpenseBasis argument so the VAT and income-tax reports cannot drift except on which date they use."}, {"id": "app_readme_vat_report", "label": "\u05d3\u05d5\u05d7 \u05de\u05e2\"\u05de VAT Report", "file_type": "concept", "source_file": "app/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Counts an expense in Morning's reporting_date period so the input VAT claimed agrees with what Morning reported."}, {"id": "app_readme_income_tax_estimate", "label": "\u05de\u05e1 \u05d4\u05db\u05e0\u05e1\u05d4 Income Tax Estimate", "file_type": "concept", "source_file": "app/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Follows the real order: \u05d1\u05d9\u05d8\u05d5\u05d7 \u05dc\u05d0\u05d5\u05de\u05d9 on profit, 52% of it deducted, brackets applied, \u05e0\u05e7\u05d5\u05d3\u05d5\u05ea \u05d6\u05d9\u05db\u05d5\u05d9 off the tax; explicitly an estimate."}, {"id": "app_readme_tax_rates", "label": "TAX_RATES (server/reports.ts)", "file_type": "concept", "source_file": "app/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Pinned to the year they were published for and reported next to the figures, so a stale table is visible rather than silently wrong."}, {"id": "app_readme_tax_filings", "label": "tax_filings (\u05d3\u05d5\u05d5\u05d7 / \u05e9\u05d5\u05dc\u05dd ticks)", "file_type": "concept", "source_file": "app/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "app_readme_period_filter", "label": "Period Filter (dateRange)", "file_type": "concept", "source_file": "app/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "app_readme_moonlight_division", "label": "Moonlight Member Division (three steps)", "file_type": "concept", "source_file": "app/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Shows the working, not just the total, so each member's figure can be checked rather than trusted; refunds are kept separate from profit share."}, {"id": "app_readme_producer_fee", "label": "Producer Fee (computeDivision, commission_percent)", "file_type": "concept", "source_file": "app/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Default 20% (30/30/20/20); already-paid shows were stamped 40% on migration so the boot recompute would not silently re-divide settled money."}, {"id": "app_readme_price_quotes", "label": "Moonlight Price Quotes (\u05d4\u05e6\u05e2\u05d5\u05ea \u05de\u05d7\u05d9\u05e8)", "file_type": "concept", "source_file": "app/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "app_readme_doc_types_revenue", "label": "Revenue Document Types (docTypes.ts: 305, 320)", "file_type": "concept", "source_file": "app/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A sale yields both a 300 and a 305 carrying the full amount, so only 305/320 count as revenue to avoid counting it twice."}, {"id": "app_readme_payment_doc_types", "label": "PAYMENT_DOC_TYPES (320 requires a payment row)", "file_type": "concept", "source_file": "app/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "app_readme_am_invoice_numbering", "label": "AM-* Local Invoice Numbering", "file_type": "rationale", "source_file": "app/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Morning owns sequential numbers; numbering locally would hand out numbers Morning will issue, and creating local rows first left abandoned AM-* invoices that looked issued."}, {"id": "app_readme_morning_integration", "label": "Morning (Green Invoice) Integration", "file_type": "concept", "source_file": "app/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "app_readme_morning_pull_sync", "label": "Morning Pull Sync (/integrations/morning/sync)", "file_type": "concept", "source_file": "app/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "app_readme_morning_expenses_sync", "label": "Morning Expenses Sync (expenses-sync)", "file_type": "concept", "source_file": "app/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "app_readme_morning_push", "label": "Morning Push (createDocument / issue-to-morning)", "file_type": "concept", "source_file": "app/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "app_readme_morning_issue_dialog", "label": "Two-Step Morning Issue Dialog (morning-draft)", "file_type": "concept", "source_file": "app/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "An issued document cannot be deleted, only credited, so issuing goes through a preview step rather than a bare confirm."}, {"id": "app_readme_business_details_settings", "label": "\u05e4\u05e8\u05d8\u05d9 \u05d4\u05e2\u05e1\u05e7 Business Details Letterhead", "file_type": "concept", "source_file": "app/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "app_readme_calendar_sync", "label": "Google Calendar Sync Rules", "file_type": "concept", "source_file": "app/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "app_readme_title_only_matching", "label": "Title-only Keyword Matching", "file_type": "rationale", "source_file": "app/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Descriptions carry running orders that contain the keyword without saying whose show it is; searching them pulled four Karni Band gigs into the band rule."}, {"id": "app_readme_synced_title_cleaning", "label": "Synced Title Cleaning (show words, leading keywords)", "file_type": "concept", "source_file": "app/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "app_readme_name_locks", "label": "venue_locked / description_locked Name Locks", "file_type": "concept", "source_file": "app/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "app_readme_calendar_preview", "label": "Calendar Rule Preview (dry run)", "file_type": "concept", "source_file": "app/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "app_readme_calendar_overrides", "label": "Calendar Manual Overrides (exclude / include)", "file_type": "concept", "source_file": "app/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "app_readme_meta_ads_sync", "label": "Meta Ads Sync", "file_type": "concept", "source_file": "app/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "app_readme_campaign_show_mapping", "label": "Campaign \u2192 Show Mapping (weights, suggestions)", "file_type": "concept", "source_file": "app/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Campaign names are written for people and a campaign promoting a run of shows cannot be divided by rule, so the sync proposes and a person confirms."}, {"id": "app_readme_campaign_figure_lock", "label": "Hand-typed \u05e7\u05de\u05e4\u05d9\u05d9\u05df Figure Lock", "file_type": "rationale", "source_file": "app/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Pre-integration figures are history; rewriting them would move what the band is owed on shows already divided."}, {"id": "app_readme_settled_show_freeze", "label": "Settled Show Freeze (\u05e9\u05d5\u05dc\u05dd \u05dc\u05e0\u05d2\u05e0\u05d9\u05dd)", "file_type": "rationale", "source_file": "app/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Campaigns outlive shows; without freezing, later spend would re-divide profit already paid out to members."}, {"id": "app_readme_monthly_vs_per_show", "label": "Monthly Meta Invoice vs Per-Show Ad Cost Partitions", "file_type": "concept", "source_file": "app/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "app_readme_campaign_advisor", "label": "\u05d9\u05d5\u05e2\u05e5 \u05e7\u05de\u05e4\u05d9\u05d9\u05e0\u05d9\u05dd AI Campaign Advisor", "file_type": "concept", "source_file": "app/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "app_readme_agent_over_ssh", "label": "AI Agent over SSH (prompt on stdin)", "file_type": "rationale", "source_file": "app/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The app holds a key to one fixed command on another machine, so no AI API key exists in the container, database or any browser-visible error; the prompt never touches a command line and nothing the agent says takes effect."}, {"id": "app_readme_host_key_pinning", "label": "SSH Host Key Pinning", "file_type": "concept", "source_file": "app/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "app_readme_agent_settings", "label": "Settings \u